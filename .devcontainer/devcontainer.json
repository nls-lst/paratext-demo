{
  "name": "paratext workshop",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [5050],
  "portsAttributes": {
    "5050": { "label": "paratext review", "onAutoForward": "notify" }
  },
  "secrets": {
    "PARATEXT_API_KEY": {
      "description": "OpenRouter API key for the workshop. Provided by the facilitator.",
      "documentationUrl": "https://openrouter.ai/keys"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "tamasfe.even-better-toml"]
    }
  }
}
